# On the VPS: cp .env.production.example .env, then fill this in. Never commit the copy.
# Lets a plain `docker compose ...` use the production stack in this folder.
COMPOSE_FILE=docker-compose.prod.yml

API_DOMAIN=api.supercarstars.com
ADMIN_DOMAIN=admin.supercarstars.com
# Let's Encrypt sends certificate warnings here.
ACME_EMAIL=

# Generate each with: openssl rand -hex 32
DB_PASSWORD=
JWT_SECRET=
# Moving data from Supabase: copy this from your local backend/.env instead, or saved Stripe and email secrets won't decrypt.
SETTINGS_ENCRYPTION_KEY=

# Optional if email is set up in the dashboard under Settings, Email (SMTP).
SMTP_URL=
MAIL_FROM=Supercarstars <no-reply@supercarstars.com>

# Only for a new, empty database (dist/scripts/seed.js). Password of at least 10 characters. Remove after seeding.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
