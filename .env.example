NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://supercars:supercars_dev_pw@127.0.0.1:5440/supercars
# Used by `npm test` (separate database; tables are wiped between tests)
TEST_DATABASE_URL=postgres://supercars:supercars_dev_pw@127.0.0.1:5440/supercars_test
# TLS is on automatically for non-local databases (e.g. Supabase). Force with DATABASE_SSL=true or false.
# DATABASE_SSL=
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-32-bytes-hex
SETTINGS_ENCRYPTION_KEY=change-me-32-bytes-hex
# Origins allowed by CORS (dashboard, Expo web)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Which proxies may set X-Forwarded-For (used for rate limits). Default: a proxy on this machine only.
# Set to the proxy address/CIDR or hop count if it runs elsewhere. Never "true" if the API port is publicly reachable.
TRUST_PROXY=
PUBLIC_API_URL=http://localhost:4000
UPLOAD_DIR=./uploads
# Driver licence photos: private, never served publicly. Keep outside UPLOAD_DIR and include in backups.
PRIVATE_UPLOAD_DIR=./private-uploads
# First owner account created by `npm run seed`
SEED_OWNER_EMAIL=owner@supercarstars.com
SEED_OWNER_PASSWORD=change-me-now
# Optional: Stripe keys can also be set from Admin > Settings (stored encrypted). Env is a fallback.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Outgoing email (password reset codes). Any SMTP provider works, e.g. smtps://user:pass@smtp.example.com:465
# Leave SMTP_URL empty in development: codes are printed in the API log instead. Production needs it.
SMTP_URL=
MAIL_FROM=Supercarstars <no-reply@yourdomain.com>
